{
  "name": "animeon-desktop",
  "version": "0.3.0",
  "description": "Animeon Desktop",
  "main": "dist/main/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently \"vite\" \"tsc -p tsconfig.main.json --watch\" \"wait-on dist/main/index.js && electron .\"",
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "build": "tsc -p tsconfig.main.json && vite build && electron-builder",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "preview": "vite preview",
    "lint": "eslint ."
  },
  "build": {
    "appId": "com.kotecy.animeon-desktop",
    "productName": "Animeon Desktop",
    "files": [
      "dist/**/*",
      "build/icon.png",
      "package.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "Kotecy",
      "repo": "Animeon-Desktop"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "AnimeonDesktop.exe"
    },
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "extraMetadata": {
      "main": "dist/main/index.js"
    }
  },
  "dependencies": {
    "chrome-cookies-secure": "^3.0.2",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "wait-on": "^7.2.0"
  }
}
